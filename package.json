        "prettier": "^3.9.4",
        "prettier-plugin-blade": "^3.2.2",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4.0.0",
        "terser": "^5.48.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "alpinejs": "^3.15.12"
