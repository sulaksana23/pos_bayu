NEXT_PUBLIC_PRICE_SOURCE=Rp 3.500.000
NEXT_PUBLIC_CONTACT_WHATSAPP=6281234567890
NEXT_PUBLIC_CONTACT_EMAIL=sales@balitechsolution.com
NEXT_PUBLIC_CONTACT_OTHER_LABEL=Instagram
