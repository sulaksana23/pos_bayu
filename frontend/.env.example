# URL of the Laravel backend (server-side only; used by the /laravel/* proxy)
BACKEND_URL=http://127.0.0.1:8000

# Shown in the UI
NEXT_PUBLIC_APP_NAME=BaliPOS
NEXT_PUBLIC_STORE_NAME=Toko BaliPOS
NEXT_PUBLIC_STORE_ADDRESS=Jl. Raya Denpasar No. 1, Bali
NEXT_PUBLIC_STORE_PHONE=0361-000000

# Harga & kontak untuk modal "Pakai data toko sendiri" (tombol muncul di
# halaman /demo). Kosongkan kontak untuk menyembunyikan tombolnya.
